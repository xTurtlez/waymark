# ── Required ────────────────────────────────────────────────────────────────
# Postgres 16+. In production use a London (eu-west-2) Neon or Supabase database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/waymark
# 32+ random characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public URL of the app (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000

# ── Email ───────────────────────────────────────────────────────────────────
# outbox (default: stored in the database, readable at /dev/outbox outside production) | postmark
MAIL_DRIVER=outbox
POSTMARK_SERVER_TOKEN=
MAIL_FROM="Waymark <no-reply@example.com>"

# ── File storage ────────────────────────────────────────────────────────────
# local (dev only) | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/files
S3_BUCKET=
S3_REGION=eu-west-2
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# eicar (dev: rejects the EICAR test signature) | none
MALWARE_SCANNER=eicar

# ── Jobs ────────────────────────────────────────────────────────────────────
# Shared secret for Vercel Cron calling /api/jobs/run
CRON_SECRET=

# ── Optional: Microsoft Entra SSO for firm staff ────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# ── Seed ────────────────────────────────────────────────────────────────────
# Password for demo staff accounts created by `npm run db:seed`
SEED_STAFF_PASSWORD=waymark-demo-password
